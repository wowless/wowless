{
  "buildPresets": [
    {
      "configuration": "Debug",
      "configurePreset": "windows",
      "name": "windows-debug"
    },
    {
      "configuration": "Release",
      "configurePreset": "windows-amd64",
      "name": "windows-amd64"
    },
    {
      "configuration": "Debug",
      "configurePreset": "windows-amd64",
      "name": "windows-amd64-debug"
    },
    {
      "configuration": "Debug",
      "configurePreset": "macos",
      "name": "macos-debug"
    },
    {
      "configuration": "Debug",
      "configurePreset": "linux",
      "name": "linux-debug"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24
  },
  "configurePresets": [
    {
      "architecture": {
        "strategy": "external",
        "value": "x64"
      },
      "inherits": "windows",
      "name": "windows-amd64",
      "toolset": {
        "strategy": "external",
        "value": "host=x64"
      }
    }
  ],
  "version": 3
}
