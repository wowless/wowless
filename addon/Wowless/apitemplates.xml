<Ui>
  <!--
    Templates used to check whether the various Create*() APIs that take a
    template/templateName argument accept more than one template name
    (comma-separated, the way XML inherits= does) or reject/ignore it. See
    templates.lua.
  -->
  <Frame name='WowlessApiTemplateKeyValues1' virtual='true'>
    <KeyValues>
      <KeyValue key='apiTemplateFrom1' value='true' type='boolean' />
    </KeyValues>
  </Frame>
  <Frame name='WowlessApiTemplateKeyValues2' virtual='true'>
    <KeyValues>
      <KeyValue key='apiTemplateFrom2' value='true' type='boolean' />
    </KeyValues>
  </Frame>

  <AnimationGroup name='WowlessApiTemplateLooping1' virtual='true' looping='REPEAT' />
  <AnimationGroup name='WowlessApiTemplateLooping2' virtual='true' looping='BOUNCE' />

  <Animation name='WowlessApiTemplateSmoothing1' virtual='true' smoothing='IN' />
  <Animation name='WowlessApiTemplateSmoothing2' virtual='true' smoothing='OUT' />

  <Frame name='WowlessApiTemplateEmpty1' virtual='true' />
  <Frame name='WowlessApiTemplateEmpty2' virtual='true' />
</Ui>
